{
  "name": "scentora-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SCENTORA - React admin portal for a perfume e-commerce store",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "json-server --watch db.json --port 3001",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "jsdom": "^25.0.0",
    "json-server": "^1.0.0-beta.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}